# BIS Conformity Assessment RAG Assistant — cloud database configuration
# Copy to .env and fill in your credentials. Never commit real secrets.

# ── Vector database provider ────────────────────────────────────────────────
# "auto": Pinecone when PINECONE_API_KEY is set, otherwise local ChromaDB.
# "chroma": force the local ChromaDB store even when a Pinecone key exists.
VECTOR_DB_PROVIDER=auto

# Pinecone (https://app.pinecone.io) — serverless index
PINECONE_API_KEY=iaminevitable
# Optional: override API environment (only needed for pod-based legacy indexes)
# PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=bis-codebooks
# Optional: PINECONE_HOST=https://<project>-<env>.svc.<region>.pinecone.io
# (when omitted the SDK resolves the host from the API key automatically)
# PINECONE_HOST=
# Serverless index location (used only when the index does not exist yet)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Neo4j graph database (Neo4j Aura or self-hosted) ───────────────────────
# Use the neo4j+s:// scheme for Aura free tier (full TLS).
NEO4J_URI=neo4j+s://00000000.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j